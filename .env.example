# Copy to .env and fill in. .env is git-ignored.

# Anthropic API
ANTHROPIC_API_KEY=
DOCFLOW_MODEL=claude-sonnet-5-5

# Service (service/docflow)
DOCFLOW_PROMPT=extract_v2
CONFIDENCE_THRESHOLD=0.6          # chosen in eval/RESULTS.md
DOCFLOW_AGENT_MODEL=claude-haiku-5-5    # Q&A agent (/ask); 12/13 on the QA eval (Sonnet 13/13), ~1/15 of the cost
DOCFLOW_AGENT_EFFORT=low          # short chat answers
SERVICE_API_KEY=                  # required header X-API-Key; empty = API answers 503
# DOCFLOW_DEV=1                   # local experiments only: run the API without SERVICE_API_KEY
# DATABASE_URL=sqlite:///data/docflow.db   # or postgresql+psycopg://user:pass@db/docflow
# STORAGE_DIR=data/files
# MAX_FILE_MB=20
# MAX_PAGES=20

# Optional: TTF fonts with Cyrillic + Polish glyphs for generate_dataset.py
# (auto-detected: DejaVu on Linux, Arial on Windows/macOS)
# DOCFLOW_FONT=
# DOCFLOW_FONT_BOLD=

# Telegram + n8n (docker-compose)
TELEGRAM_BOT_TOKEN=               # from @BotFather
TELEGRAM_WEBHOOK_SECRET=          # required: long random string (A-Z a-z 0-9 _ -); checked by the workflow
TELEGRAM_ALLOWED_CHAT_IDS=        # required: comma-separated chat ids allowed to use the bot; empty = nobody
REMINDERS_WEBHOOK_KEY=            # X-API-Key for the manual reminders webhook; empty = webhook disabled
# REMINDER_DAYS=7,3,1,0           # remind this many days before a deadline (daily at 09:00 Kyiv)
# POSTGRES_PASSWORD=docflow
# N8N_VERSION=2.49.5
