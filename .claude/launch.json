    {
      "name": "mock-telegram",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "n8n/mock_telegram.py",
        "--port",
        "8081",
        "--root",
        "eval/dataset_test"
      ],
      "port": 8081
    }
  ]
}
